include(FetchContent)
set(ENABLE_PROGRAMS OFF)
set(ENABLE_TESTING OFF)
if (PLATFORM_SWITCH)
    set(DANMAKU_PORTLIBS "$ENV{DEVKITPRO}/portlibs/switch")
    find_path(DANMAKU_MBEDTLS_INCLUDE mbedtls/ssl.h PATHS "${DANMAKU_PORTLIBS}/include" NO_DEFAULT_PATH REQUIRED)
    foreach(tls_target mbedtls mbedx509 mbedcrypto)
        find_library(DANMAKU_${tls_target}_LIBRARY NAMES ${tls_target} PATHS "${DANMAKU_PORTLIBS}/lib" NO_DEFAULT_PATH REQUIRED)
        add_library(${tls_target} INTERFACE)
        target_link_libraries(${tls_target} INTERFACE "${DANMAKU_${tls_target}_LIBRARY}")
        target_include_directories(${tls_target} INTERFACE "${DANMAKU_MBEDTLS_INCLUDE}")
    endforeach()
    set(DANMAKU_TLS_LICENSE "${DANMAKU_PORTLIBS}/licenses/switch-mbedtls/LICENSE")
else()
    FetchContent_Declare(mbedtls
        URL https://github.com/Mbed-TLS/mbedtls/archive/refs/tags/v2.28.9.tar.gz
        URL_HASH SHA256=e4dbcf86a4fb31506482888560f02b161e0ecfb82fee0643abcfc86abee5817e)
    set(CMAKE_POLICY_VERSION_MINIMUM 3.5)
    FetchContent_MakeAvailable(mbedtls)
    unset(CMAKE_POLICY_VERSION_MINIMUM)
    set(DANMAKU_TLS_LICENSE "${mbedtls_SOURCE_DIR}/LICENSE")
endif()

set(DANMAKU_TLS_DIR ${CMAKE_BINARY_DIR}/danmaku-tls)
file(MAKE_DIRECTORY ${DANMAKU_TLS_DIR})
if (NOT EXISTS ${DANMAKU_TLS_DIR}/cacert.pem)
    file(DOWNLOAD https://curl.se/ca/cacert-2025-09-09.pem ${DANMAKU_TLS_DIR}/cacert.pem
        EXPECTED_HASH SHA256=f290e6acaf904a4121424ca3ebdd70652780707e28e8af999221786b86bb1975 TLS_VERIFY ON)
endif()
file(READ ${DANMAKU_TLS_DIR}/cacert.pem DANMAKU_CA)
file(WRITE ${DANMAKU_TLS_DIR}/danmaku_ca.hpp "#pragma once\nstatic const char DANMAKU_CA[] = R\"ca(${DANMAKU_CA})ca\";\n")
target_include_directories(mongoose PUBLIC ${DANMAKU_TLS_DIR})
target_compile_definitions(mongoose PUBLIC MG_TLS=MG_TLS_MBED)
target_link_libraries(mongoose PUBLIC mbedtls mbedx509 mbedcrypto)